<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_expense_reimbursement_to_be" targetNamespace="https://example.local/business-process" exporter="Business Process Publisher Skill" exporterVersion="1.16.0">
  <bpmn:process id="Process_expense_reimbursement_to_be" name="経費精算業務（To-Be）" isExecutable="false">
    <bpmn:laneSet id="LaneSet_expense_reimbursement_to_be">
      <bpmn:lane id="Lane_employee" name="社員">
        <bpmn:flowNodeRef>Node_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_submit_expense</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_revise_resubmit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_manager" name="直属の上長">
        <bpmn:flowNodeRef>Node_manager_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_defect_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_manager_return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_department_head" name="部門長">
        <bpmn:flowNodeRef>Node_department_head_review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_approval_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_department_head_return</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_accounting" name="経理担当者">
        <bpmn:flowNodeRef>Node_approval_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_correct_registration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_correct_evidence_storage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_bank_transfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_transfer_result_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_resolve_transfer_failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_automation_system" name="自動処理">
        <bpmn:flowNodeRef>Node_amount_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_parallel_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_register_accounting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_registration_error_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_store_evidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_evidence_result_gateway</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Node_parallel_join</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Node_start" name="経費申請を開始" />
    <bpmn:userTask id="Node_submit_expense" name="申請内容とエビデンスを登録して申請">
      <bpmn:documentation>社員が申請内容とエビデンスを登録する。共通の必須項目、形式、エビデンス要件を送信前に検証し、不備がなければ申請する。</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:task id="Node_manager_review" name="申請内容とエビデンスを確認">
      <bpmn:documentation>直属の上長が申請内容とエビデンスを審査し、判断結果、日時、コメントを一元管理する。</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Node_defect_gateway" name="内容に不備があるか" gatewayDirection="Diverging" default="Flow_e05" />
    <bpmn:task id="Node_manager_return" name="社員へ差し戻し">
      <bpmn:documentation>直属の上長が共通の差し戻し分類、具体的指摘、修正対象、再確認対象を記録して社員へ差し戻す。</bpmn:documentation>
    </bpmn:task>
    <bpmn:userTask id="Node_revise_resubmit" name="内容を修正して再申請">
      <bpmn:documentation>社員が標準化された差し戻し理由、具体的指摘、修正対象に基づいて内容またはエビデンスを修正し、送信前検証後に再申請する。</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Node_amount_gateway" name="精算予定総額が5万円以上か" gatewayDirection="Diverging" default="Flow_e10" />
    <bpmn:task id="Node_department_head_review" name="申請を審査">
      <bpmn:documentation>部門長が5万円以上の経費申請を審査し、判断結果、日時、コメントを一元管理する。</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Node_approval_gateway" name="部門長の審査結果" gatewayDirection="Diverging" default="Flow_e13" />
    <bpmn:task id="Node_department_head_return" name="社員へ差し戻し">
      <bpmn:documentation>部門長が共通の差し戻し分類、具体的指摘、修正対象、再確認対象を記録して社員へ差し戻す。</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Node_approval_merge" name="必要な承認を完了" gatewayDirection="Converging" />
    <bpmn:parallelGateway id="Node_parallel_split" name="経理処理を並行開始" gatewayDirection="Diverging" />
    <bpmn:serviceTask id="Node_register_accounting" name="会計システムへ経費情報を連携">
      <bpmn:documentation>必要承認後の経費申請を標準マッピングで会計システムへ自動連携し、成功・失敗・失敗理由を申請単位で記録する。</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_registration_error_gateway" name="会計連携が成功したか" gatewayDirection="Diverging" default="Flow_e20" />
    <bpmn:userTask id="Node_correct_registration" name="会計連携の例外を是正">
      <bpmn:documentation>経理担当者が会計連携の失敗理由または期限超過を確認し、原因を是正して再実行する。</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Node_store_evidence" name="エビデンスを自動保管">
      <bpmn:documentation>必要承認後にエビデンスを所定の保管先へ自動保存し、申請ID、保存先、保存結果、版を記録する。</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Node_evidence_result_gateway" name="エビデンス保管が成功したか" gatewayDirection="Diverging" default="Flow_e26" />
    <bpmn:userTask id="Node_correct_evidence_storage" name="エビデンス保管の例外を是正">
      <bpmn:documentation>経理担当者がエビデンス保管の失敗理由または期限超過を確認し、原因を是正して再実行する。</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Node_parallel_join" name="登録と保管の完了を待ち合わせ" gatewayDirection="Converging" />
    <bpmn:task id="Node_bank_transfer" name="振込を実行して結果を記録">
      <bpmn:documentation>振込対象、金額、口座参照、支払日、申請IDを使用して振込を実行し、受付番号、実行日時、成否、失敗理由を記録する。</bpmn:documentation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Node_transfer_result_gateway" name="振込が成功したか" gatewayDirection="Diverging" default="Flow_e30" />
    <bpmn:task id="Node_resolve_transfer_failure" name="振込失敗を是正">
      <bpmn:documentation>経理担当者が振込失敗理由を確認し、定められた再実行、取消、照合ルールに従って原因を是正する。</bpmn:documentation>
    </bpmn:task>
    <bpmn:endEvent id="Node_end" name="経費精算を完了" />
    <bpmn:sequenceFlow id="Flow_e01" sourceRef="Node_start" targetRef="Node_submit_expense" />
    <bpmn:sequenceFlow id="Flow_e02" sourceRef="Node_submit_expense" targetRef="Node_manager_review" />
    <bpmn:sequenceFlow id="Flow_e03" sourceRef="Node_manager_review" targetRef="Node_defect_gateway" />
    <bpmn:sequenceFlow id="Flow_e04" sourceRef="Node_defect_gateway" targetRef="Node_manager_return" name="不備あり">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">申請内容またはエビデンスに不備がある</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_e05" sourceRef="Node_defect_gateway" targetRef="Node_amount_gateway" name="不備なし" />
    <bpmn:sequenceFlow id="Flow_e06" sourceRef="Node_manager_return" targetRef="Node_revise_resubmit" />
    <bpmn:sequenceFlow id="Flow_e07" sourceRef="Node_revise_resubmit" targetRef="Node_manager_review" />
    <bpmn:sequenceFlow id="Flow_e09" sourceRef="Node_amount_gateway" targetRef="Node_department_head_review" name="5万円以上">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">申請単位の精算予定総額（税込・日本円換算後）が50000円以上</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_e10" sourceRef="Node_amount_gateway" targetRef="Node_approval_merge" name="5万円未満" />
    <bpmn:sequenceFlow id="Flow_e11" sourceRef="Node_department_head_review" targetRef="Node_approval_gateway" />
    <bpmn:sequenceFlow id="Flow_e12" sourceRef="Node_approval_gateway" targetRef="Node_approval_merge" name="承認">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">部門長が承認</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_e13" sourceRef="Node_approval_gateway" targetRef="Node_department_head_return" name="差し戻し" />
    <bpmn:sequenceFlow id="Flow_e14" sourceRef="Node_department_head_return" targetRef="Node_revise_resubmit" />
    <bpmn:sequenceFlow id="Flow_e15" sourceRef="Node_approval_merge" targetRef="Node_parallel_split" />
    <bpmn:sequenceFlow id="Flow_e16" sourceRef="Node_parallel_split" targetRef="Node_register_accounting" />
    <bpmn:sequenceFlow id="Flow_e17" sourceRef="Node_parallel_split" targetRef="Node_store_evidence" />
    <bpmn:sequenceFlow id="Flow_e18" sourceRef="Node_register_accounting" targetRef="Node_registration_error_gateway" />
    <bpmn:sequenceFlow id="Flow_e19" sourceRef="Node_registration_error_gateway" targetRef="Node_parallel_join" name="成功">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">会計連携が成功</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_e20" sourceRef="Node_registration_error_gateway" targetRef="Node_correct_registration" name="失敗・期限超過" />
    <bpmn:sequenceFlow id="Flow_e21" sourceRef="Node_correct_registration" targetRef="Node_register_accounting" />
    <bpmn:sequenceFlow id="Flow_e22" sourceRef="Node_store_evidence" targetRef="Node_evidence_result_gateway" />
    <bpmn:sequenceFlow id="Flow_e25" sourceRef="Node_evidence_result_gateway" targetRef="Node_parallel_join" name="成功">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">エビデンス保管が成功</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_e26" sourceRef="Node_evidence_result_gateway" targetRef="Node_correct_evidence_storage" name="失敗・期限超過" />
    <bpmn:sequenceFlow id="Flow_e27" sourceRef="Node_correct_evidence_storage" targetRef="Node_store_evidence" />
    <bpmn:sequenceFlow id="Flow_e23" sourceRef="Node_parallel_join" targetRef="Node_bank_transfer" />
    <bpmn:sequenceFlow id="Flow_e28" sourceRef="Node_bank_transfer" targetRef="Node_transfer_result_gateway" />
    <bpmn:sequenceFlow id="Flow_e29" sourceRef="Node_transfer_result_gateway" targetRef="Node_end" name="成功">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">振込が成功</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_e30" sourceRef="Node_transfer_result_gateway" targetRef="Node_resolve_transfer_failure" name="失敗" />
    <bpmn:sequenceFlow id="Flow_e31" sourceRef="Node_resolve_transfer_failure" targetRef="Node_bank_transfer" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_expense_reimbursement_to_be">
    <bpmndi:BPMNPlane id="BPMNPlane_expense_reimbursement_to_be" bpmnElement="Process_expense_reimbursement_to_be">
